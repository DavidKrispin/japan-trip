---
import Base from '../../../layouts/Base.astro';
---
<Base title="עריכת יום">
  <div>
    <a href="/admin/trip" class="text-sm text-sakura-600 hover:underline">← חזרה לניהול</a>
    <h1 class="text-2xl font-bold mt-2 mb-6">✏️ עריכת יום</h1>

    <form id="day-form" class="space-y-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div class="grid grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1">כותרת</label><input id="day-title" type="text" class="w-full px-3 py-2 border rounded-lg" placeholder="יום בטוקיו" /></div>
        <div><label class="block text-sm font-medium mb-1">תאריך</label><input id="day-date" type="date" class="w-full px-3 py-2 border rounded-lg" /></div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div><label class="block text-sm font-medium mb-1">עיר</label><input id="day-city" type="text" class="w-full px-3 py-2 border rounded-lg" placeholder="Tokyo" /></div>
        <div><label class="block text-sm font-medium mb-1">מלון</label><input id="day-hotel" type="text" class="w-full px-3 py-2 border rounded-lg" placeholder="שם המלון" /></div>
      </div>
      <div><label class="block text-sm font-medium mb-1">קישור אישור מלון</label><input id="day-hotel-conf" type="url" class="w-full px-3 py-2 border rounded-lg" placeholder="https://..." /></div>
      <hr />
      <div><label class="block text-sm font-medium mb-2">📍 אטרקציות</label><div id="attractions-container" class="space-y-2"></div><button type="button" id="add-attraction" class="mt-2 text-sm text-green-600 hover:underline">➕ הוסף אטרקציה</button></div>
      <hr />
      <div><label class="block text-sm font-medium mb-2">🎫 כרטיסים</label><div id="tickets-container" class="space-y-2"></div><button type="button" id="add-ticket" class="mt-2 text-sm text-green-600 hover:underline">➕ הוסף כרטיס</button></div>
      <hr />
      <div><label class="block text-sm font-medium mb-1">📝 הערות</label><textarea id="day-notes" rows="3" class="w-full px-3 py-2 border rounded-lg text-sm"></textarea></div>
      <div class="flex gap-3">
        <button type="submit" class="flex-1 py-2 bg-sakura-600 text-white rounded-lg font-bold hover:bg-sakura-700">💾 שמור</button>
        <button type="button" id="delete-btn" class="py-2 px-4 bg-red-100 text-red-600 rounded-lg hover:bg-red-200 text-sm">🗑️ מחק</button>
      </div>
    </form>
  </div>
  <script>
    const dayId = new URLSearchParams(window.location.search).get('id');
    if (!dayId) window.location.href = '/admin/trip';
    let dayData = {};

    async function load() {
      try { const res = await fetch(`/api/day/${dayId}`); if (res.ok) dayData = await res.json(); } catch(e) {}
      fillForm();
    }

    function fillForm() {
      document.getElementById('day-title').value = dayData.title || '';
      document.getElementById('day-date').value = dayData.date || '';
      document.getElementById('day-city').value = dayData.city || '';
      document.getElementById('day-hotel').value = dayData.hotel || '';
      document.getElementById('day-hotel-conf').value = dayData.hotelConfirmation || '';
      document.getElementById('day-notes').value = dayData.notes || '';
      renderAttractions(dayData.attractions || []);
      renderTickets(dayData.tickets || []);
    }

    function renderAttractions(list) {
      const c = document.getElementById('attractions-container');
      c.innerHTML = list.map((a,i) => attrHtml(a,i)).join('');
      c.querySelectorAll('.remove-attr').forEach(b => b.addEventListener('click', () => b.closest('[data-idx]').remove()));
    }
    function attrHtml(a,i) {
      return `<div class="p-3 border rounded-lg bg-gray-50" data-idx="${i}"><div class="grid grid-cols-3 gap-2 mb-1"><input class="attr-name px-2 py-1 border rounded text-sm" value="${a.name||''}" placeholder="שם"/><input class="attr-duration px-2 py-1 border rounded text-sm" value="${a.duration||''}" placeholder="משך"/><input class="attr-address px-2 py-1 border rounded text-sm" value="${a.address||''}" placeholder="כתובת"/></div><div class="flex gap-2"><input class="attr-notes flex-1 px-2 py-1 border rounded text-sm" value="${a.notes||''}" placeholder="הערות"/><button type="button" class="remove-attr text-red-400 text-sm">✕</button></div></div>`;
    }
    function renderTickets(list) {
      const c = document.getElementById('tickets-container');
      c.innerHTML = list.map((t,i) => `<div class="flex gap-2" data-tidx="${i}"><input class="ticket-name flex-1 px-2 py-1 border rounded text-sm" value="${t.name||''}" placeholder="שם"/><input class="ticket-url flex-1 px-2 py-1 border rounded text-sm" value="${t.url||''}" placeholder="קישור"/><button type="button" class="remove-ticket text-red-400 text-sm">✕</button></div>`).join('');
      c.querySelectorAll('.remove-ticket').forEach(b => b.addEventListener('click', () => b.closest('[data-tidx]').remove()));
    }

    document.getElementById('add-attraction').addEventListener('click', () => {
      const c = document.getElementById('attractions-container');
      const div = document.createElement('div'); div.innerHTML = attrHtml({}, c.children.length);
      const el = div.firstElementChild; c.appendChild(el);
      el.querySelector('.remove-attr').addEventListener('click', () => el.remove());
    });
    document.getElementById('add-ticket').addEventListener('click', () => {
      const c = document.getElementById('tickets-container');
      const div = document.createElement('div'); div.className='flex gap-2'; div.dataset.tidx=c.children.length;
      div.innerHTML = `<input class="ticket-name flex-1 px-2 py-1 border rounded text-sm" placeholder="שם"/><input class="ticket-url flex-1 px-2 py-1 border rounded text-sm" placeholder="קישור"/><button type="button" class="remove-ticket text-red-400 text-sm">✕</button>`;
      c.appendChild(div);
      div.querySelector('.remove-ticket').addEventListener('click', () => div.remove());
    });

    document.getElementById('day-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const attractions = [...document.querySelectorAll('#attractions-container>[data-idx]')].map(el => ({
        name: el.querySelector('.attr-name').value, duration: el.querySelector('.attr-duration').value,
        address: el.querySelector('.attr-address').value, notes: el.querySelector('.attr-notes').value,
      })).filter(a => a.name);
      const tickets = [...document.querySelectorAll('#tickets-container>[data-tidx]')].map(el => ({
        name: el.querySelector('.ticket-name').value, url: el.querySelector('.ticket-url').value,
      })).filter(t => t.name || t.url);
      const day = { id: dayId, title: document.getElementById('day-title').value, date: document.getElementById('day-date').value,
        city: document.getElementById('day-city').value, hotel: document.getElementById('day-hotel').value,
        hotelConfirmation: document.getElementById('day-hotel-conf').value, notes: document.getElementById('day-notes').value, attractions, tickets };
      await fetch(`/api/day/${dayId}`, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(day) });
      alert('נשמר!');
    });

    document.getElementById('delete-btn').addEventListener('click', async () => {
      if (!confirm('למחוק?')) return;
      await fetch(`/api/day/${dayId}`, { method: 'DELETE' });
      window.location.href = '/admin/trip';
    });

    load();
  </script>
</Base>
