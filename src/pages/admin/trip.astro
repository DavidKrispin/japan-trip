---
import Base from '../../layouts/Base.astro';
---
<Base title="ניהול טיול">
  <div>
    <h1 class="text-2xl font-bold mb-6">⚙️ ניהול טיול</h1>

    <form id="trip-form" class="space-y-4 bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
      <div>
        <label class="block text-sm font-medium mb-1">שם הטיול</label>
        <input id="trip-name" type="text" class="w-full px-3 py-2 border rounded-lg" placeholder="הטיול שלנו ליפן" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium mb-1">תאריך התחלה</label>
          <input id="trip-start" type="date" class="w-full px-3 py-2 border rounded-lg" />
        </div>
        <div>
          <label class="block text-sm font-medium mb-1">תאריך סיום</label>
          <input id="trip-end" type="date" class="w-full px-3 py-2 border rounded-lg" />
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">אזורים (שם + ימים, שורה לכל אזור)</label>
        <textarea id="trip-regions" rows="4" class="w-full px-3 py-2 border rounded-lg text-sm" placeholder="טוקיו, 5&#10;קיוטו, 3&#10;אוסקה, 2"></textarea>
      </div>
      <button type="submit" class="w-full py-2 bg-sakura-600 text-white rounded-lg font-bold hover:bg-sakura-700">💾 שמור</button>
    </form>

    <hr class="my-8" />

    <!-- Days management -->
    <h2 class="text-lg font-bold mb-4">📅 ימי הטיול</h2>
    <div id="days-list" class="space-y-2 mb-4"></div>
    <button id="add-day-btn" class="w-full py-2 bg-green-600 text-white rounded-lg font-bold hover:bg-green-700">➕ הוסף יום</button>

    <hr class="my-8" />

    <!-- Saved places management -->
    <h2 class="text-lg font-bold mb-4">⭐ מקומות שמורים</h2>
    <a href="/admin/saved" class="px-4 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 text-sm">ניהול מקומות שמורים →</a>
  </div>

  <script>
    let tripData = { trip: {}, days: [] };

    async function apiFetch(url, opts) {
      const res = await fetch(url, opts);
      const text = await res.text();
      let data = null;
      try { data = text ? JSON.parse(text) : null; } catch(e) {}
      if (!res.ok) {
        const msg = (data && (data.message || data.error)) || `HTTP ${res.status}`;
        const err = new Error(msg);
        err.status = res.status;
        err.body = data;
        throw err;
      }
      return data;
    }

    async function loadTrip() {
      try {
        tripData = await apiFetch('/api/trip');
      } catch(e) {
        console.error('loadTrip failed:', e);
        alert('⚠️ טעינת הטיול נכשלה: ' + e.message);
        tripData = { trip: {}, days: [] };
      }
      fillForm();
      renderDays();
    }

    function fillForm() {
      const t = tripData.trip || {};
      document.getElementById('trip-name').value = t.name || '';
      document.getElementById('trip-start').value = t.startDate || '';
      document.getElementById('trip-end').value = t.endDate || '';
      if (t.regions) {
        document.getElementById('trip-regions').value = t.regions.map(r => `${r.name}, ${r.days}`).join('\n');
      }
    }

    function renderDays() {
      const el = document.getElementById('days-list');
      const days = tripData.days || [];
      el.innerHTML = days.map((d, i) => `
        <div class="flex items-center justify-between p-3 bg-white rounded-lg border">
          <span>יום ${i+1}: ${d.title || d.date || '---'} (${d.city || ''})</span>
          <a href="/admin/day/?id=${d.id}" class="text-sm text-sakura-600 hover:underline">✏️ ערוך</a>
        </div>
      `).join('') || '<p class="text-gray-400 text-sm">אין ימים</p>';
    }

    document.getElementById('trip-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const regions = document.getElementById('trip-regions').value.split('\n').filter(Boolean).map(line => {
        const [name, days] = line.split(',').map(s => s.trim());
        return { name, days: parseInt(days) || 0 };
      });
      const trip = {
        name: document.getElementById('trip-name').value,
        startDate: document.getElementById('trip-start').value,
        endDate: document.getElementById('trip-end').value,
        regions
      };
      const btn = e.submitter;
      if (btn) { btn.disabled = true; btn.textContent = '💾 שומר...'; }
      try {
        await apiFetch('/api/trip', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trip })
        });
        await loadTrip();
        alert('✅ נשמר!');
      } catch(err) {
        console.error('save trip failed:', err);
        alert('❌ שמירה נכשלה: ' + err.message);
      } finally {
        if (btn) { btn.disabled = false; btn.textContent = '💾 שמור'; }
      }
    });

    document.getElementById('add-day-btn').addEventListener('click', async () => {
      const id = 'day-' + Date.now();
      const dayNum = (tripData.days || []).length + 1;
      const day = { id, dayNumber: dayNum, title: '', city: '', date: '', hotel: '', attractions: [], tickets: [], notes: '' };
      try {
        await apiFetch('/api/day/' + id, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(day)
        });
        window.location.href = '/admin/day/?id=' + id;
      } catch(err) {
        console.error('add day failed:', err);
        alert('❌ הוספת יום נכשלה: ' + err.message);
      }
    });

    loadTrip();
  </script>
</Base>
