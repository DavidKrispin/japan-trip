---
import Base from '../../layouts/Base.astro';
---
<Base title="יום בטיול">
  <div id="app">
    <div id="loading" class="text-center py-12 text-gray-400">טוען...</div>
    <div id="content" class="hidden">
      <div class="mb-6">
        <a href="/" class="text-sm text-sakura-600 hover:underline">← חזרה לסקירה</a>
        <h1 class="text-2xl font-bold mt-2" id="day-title"></h1>
        <p class="text-gray-500 text-sm" id="day-date"></p>
      </div>
      <div id="weather-widget" class="mb-6 p-4 bg-blue-50 rounded-xl border border-blue-100 hidden">
        <div class="flex items-center gap-3">
          <span class="text-3xl" id="weather-icon">☀️</span>
          <div>
            <span class="font-bold text-lg" id="weather-temp"></span>
            <span class="text-sm text-gray-500 mr-2" id="weather-desc"></span>
          </div>
        </div>
      </div>
      <div id="hotel-section" class="mb-6 p-4 bg-white rounded-xl shadow-sm border border-gray-100 hidden">
        <h2 class="font-bold text-sm text-gray-400 mb-2">🏨 מלון</h2>
        <p class="font-bold" id="hotel-name"></p>
        <a id="hotel-map" class="text-sm text-blue-600 hover:underline" target="_blank">📍 הצג במפה</a>
        <div id="hotel-confirmation" class="mt-2 hidden">
          <a id="hotel-conf-link" class="text-sm text-sakura-600 hover:underline" target="_blank">📄 אישור הזמנה</a>
        </div>
      </div>
      <div class="mb-6">
        <h2 class="font-bold text-sm text-gray-400 mb-3">📍 אטרקציות</h2>
        <div id="attractions-list" class="space-y-3"></div>
      </div>
      <div id="tickets-section" class="mb-6 hidden">
        <h2 class="font-bold text-sm text-gray-400 mb-3">🎫 כרטיסים</h2>
        <div id="tickets-list" class="space-y-2"></div>
      </div>
      <div id="notes-section" class="mb-6 hidden">
        <h2 class="font-bold text-sm text-gray-400 mb-2">📝 הערות</h2>
        <p id="day-notes" class="text-sm text-gray-600 bg-yellow-50 p-3 rounded-lg"></p>
      </div>
      <div class="mt-8 text-center">
        <a id="edit-link" class="px-4 py-2 bg-gray-100 text-gray-600 rounded-lg hover:bg-gray-200 text-sm">✏️ ערוך יום זה</a>
      </div>
    </div>
  </div>
  <script>
    const dayId = new URLSearchParams(window.location.search).get('id');
    if (!dayId) window.location.href = '/';

    async function load() {
      try {
        const res = await fetch(`/api/day/${dayId}`);
        if (!res.ok) throw new Error(res.status);
        render(await res.json());
      } catch(e) {
        document.getElementById('loading').textContent = 'לא נמצא.';
      }
    }

    function render(day) {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('content').classList.remove('hidden');
      document.getElementById('day-title').textContent = day.title || 'יום ' + (day.dayNumber || '');
      document.getElementById('day-date').textContent = `${day.date || ''} • ${day.city || ''}`;
      document.getElementById('edit-link').href = `/admin/day/?id=${dayId}`;

      if (day.hotel) {
        document.getElementById('hotel-section').classList.remove('hidden');
        document.getElementById('hotel-name').textContent = day.hotel;
        document.getElementById('hotel-map').href = `https://www.google.com/maps/search/${encodeURIComponent(day.hotel + ' ' + (day.city || 'Japan'))}`;
        if (day.hotelConfirmation) {
          document.getElementById('hotel-confirmation').classList.remove('hidden');
          document.getElementById('hotel-conf-link').href = day.hotelConfirmation;
        }
      }

      const listEl = document.getElementById('attractions-list');
      if (day.attractions && day.attractions.length) {
        listEl.innerHTML = day.attractions.map((a, i) => `
          <div class="p-3 bg-white rounded-lg shadow-sm border border-gray-100">
            <div class="flex items-start justify-between">
              <div><span class="text-xs text-gray-400">${i+1}.</span> <span class="font-medium">${a.name}</span>
              ${a.duration ? `<span class="text-xs text-gray-400 mr-2">⏱️ ${a.duration}</span>` : ''}</div>
              <a href="https://www.google.com/maps/search/${encodeURIComponent(a.name + ' ' + (a.address || day.city || 'Japan'))}" target="_blank" class="text-blue-500 text-sm shrink-0">📍</a>
            </div>
            ${a.notes ? `<p class="text-xs text-gray-500 mt-1">${a.notes}</p>` : ''}
          </div>
        `).join('');
      }

      if (day.tickets && day.tickets.length) {
        document.getElementById('tickets-section').classList.remove('hidden');
        document.getElementById('tickets-list').innerHTML = day.tickets.map(t => `<a href="${t.url||'#'}" target="_blank" class="block p-3 bg-white rounded-lg shadow-sm border hover:border-sakura-200">🎫 ${t.name||'כרטיס'}</a>`).join('');
      }

      if (day.notes) {
        document.getElementById('notes-section').classList.remove('hidden');
        document.getElementById('day-notes').textContent = day.notes;
      }

      if (day.city) fetchWeather(day.city);
    }

    async function fetchWeather(city) {
      try {
        const res = await fetch(`https://wttr.in/${encodeURIComponent(city)}?format=j1`);
        const data = await res.json();
        const cur = data.current_condition[0];
        document.getElementById('weather-widget').classList.remove('hidden');
        document.getElementById('weather-temp').textContent = cur.temp_C + '°C';
        document.getElementById('weather-desc').textContent = cur.weatherDesc[0].value;
      } catch(e) {}
    }

    load();
  </script>
</Base>
